# Supabase connection. Copy to `.env.local` and fill in from your Supabase
# project settings (Project Settings → API). When BOTH are set, the app talks
# to your real Supabase project with realtime syncing. When either is missing,
# the app runs in local "demo mode" (data persists to the browser only).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Storage bucket for photos, avatars, receipt scans, and expense payment
# proof. Create a PUBLIC bucket with this name in Supabase Storage. Defaults
# to "memories" if unset.
NEXT_PUBLIC_SUPABASE_BUCKET=memories

# --- Push notifications (batched activity digests) ---------------------------
# Generate a key pair with: npx web-push generate-vapid-keys
# The public key is safe to expose; the private key is server-side only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for the push service (mailto: or https: URL).
VAPID_SUBJECT=
# Shared secret for /api/notifications/cron (also set as a GitHub Actions
# repository secret — see .github/workflows/notifications-cron.yml).
CRON_SECRET=

# --- Receipt scanning (Money tab → Upload receipt) ---------------------------
# Google Gemini API key (server-side only, never exposed to the browser).
# Get a free one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: force a specific model. By default the scanner tries
# gemini-2.5-flash, then gemini-2.0-flash, then gemini-1.5-flash, skipping any
# model your key can't access. If set, this model is always tried first.
GEMINI_MODEL=
